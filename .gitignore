# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Notification / training spools written at runtime
*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# macOS
.DS_Store

# simulated patch runs — demo state, not source
runs/

# generated patch reports — demo output, not source
reports/

# Outcome records written by agent 4. Ingested alongside the curated
# corpus, but generated per run — the curated files stay tracked.
rag-setup/data/runs/

# Built by build_dataset.py from the synthetic baseline + observed outcomes
risk_score/training/data.csv

# Outcomes appended by agent 4, one row per settled host. Generated per run —
# in offline mode every row is simulated, and committing those would put fake
# observations in front of whoever next builds a training set.
risk_score/training/observed/
