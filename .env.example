# The template for .env. `./demo.sh --live` copies this to .env on its first
# run and stops so you can fill it in; `cp .env.example .env` does the same by
# hand. Either way .env is gitignored — never commit it.
#
# Shell format: KEY=value  (NOT YAML "KEY: value")
#
# Two kinds of value live here, and the difference matters:
#
#   YOURS        credentials and endpoints only you can supply.
#   GENERATED    written by a script. Editing those by hand works until the
#                next run overwrites it, so change the source instead.
#
# Quote any value containing a space. An unquoted one makes bash try to run
# the second word, and every script that sources this file then dies
# somewhere that does not mention quoting.
#
# None of this is needed for the staged demo. `./demo.sh` runs the whole
# flow with no .env at all; these are for `./demo.sh --live`.

# =========================================================================
# YOURS
# =========================================================================

# --- OpenShift ---
# Where Milvus, Llama Stack, the risk model and the console all go. Use the
# namespace that already holds them, or a new one gets a second, empty stack.
NAMESPACE=agentic-patching

# --- Insights (Lightspeed service account) ---
# Supplies the CVE list and the per-CVE detail, and decides which
# organisation the console can see at all. A host registered anywhere else
# is invisible to it no matter what else is set — that mismatch is the most
# common reason live mode finds nothing.
#
# A service account inherits no permissions from whoever created it: add it
# to a User Access group with the Vulnerability and Remediations roles.
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=
# Set false only if this machine cannot verify the sso.redhat.com chain.
# That usually means a Python without a CA store, not a real problem.
INSIGHTS_VERIFY_TLS=false

# --- Ansible Orchestrator (hosts the patching workflow) ---
# The only keys that make a patch real. Unset, the patching steps fall back
# to a simulation that touches no host and is labelled as such on the patch
# plan and on the ROI page.
AO_URL=   # e.g. https://automation-orchestrator-automation-orchestrator.apps.<cluster>.com
AO_USERNAME=   # e.g. admin
AO_PASSWORD=

# --- AAP (runs the remediation) ---
# The lab id in this URL is how discover-hosts.py tells your node1 from the
# hundreds of other node1s in the same Insights organisation. Keep the
# controller-<labid> shape, or discovery falls back to refusing to guess.
AAP_BASE_URL=   # e.g. https://controller-h77wc.apps.<cluster>.com/api/controller/v2
AAP_TOKEN=
AAP_VERIFY_TLS=false

# --- Inference, behind the RAG store ---
INFERENCE_MODEL=llama-17b/llama-scout-17b
VLLM_URL=   # e.g. https://maas-rhdp.apps.maas.redhatworkshops.io/v1
VLLM_API_TOKEN=
VLLM_TLS_VERIFY=false
DEFAULT_LLM_MODEL=vllm-inference/llama-scout-17b
RISK_VERIFY_TLS=false

# =========================================================================
# GENERATED — do not edit by hand
# =========================================================================
# Blank on purpose. Run the scripts and they fill themselves in.

# --- ./discover-hosts.py --write   (add --host <name> to pin one) ---
# Live mode refuses to assess with both HOSTS_TAG and HOSTS_FILTER empty:
# that would be the whole Insights organisation, which in a shared lab is
# everybody's machines. setup.sh runs the discovery if both are unset.
# Every identifier here is rebuilt with the lab, which is why it is
# discovered rather than typed. HOSTS_FILTER is a uuid on purpose: display
# names are not unique in a shared organisation, and they drift — the same
# host answered to 'node1' and to its full FQDN within a day.
HOSTS_TAG=
HOSTS_FILTER=
LAB_TAG=

# --- ./setup.sh ---
# Cluster endpoints, known only once things are deployed. VECTOR_DB_ID
# changes on every RAG rebuild, and a stale one returns no hits with no
# error at all.
LLAMA_STACK_URL=
VECTOR_DB_ID=
RISK_URL=

# Live-mode defaults, each chosen from what this model and this API do
# rather than from taste. REVIEW_THRESHOLD in particular: the risk model
# emits 36.6-100, so the stock 30 is below everything it can produce and
# the auto-patch branch never fires.
MODE=demo
AO_WORKFLOW_NAME=
REVIEW_THRESHOLD=
HOSTS_LIMIT=
INSIGHTS_TIMEOUT=
AO_TIMEOUT=
AO_DECIDE_WAIT=
