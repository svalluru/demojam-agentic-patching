# The template for .env. `./demo.sh --live` copies this to .env on its first
# run and stops so you can fill it in; `cp .env.example .env` does the same by
# hand. Either way .env is gitignored — never commit it.
#
# Shell format: KEY=value  (NOT YAML "KEY: value")
# Read by agentic-patching.py, frontend/server.py, ao-setup/ and rag-setup/.
#
# Blank is a valid answer. The console tries each backend and falls back per
# step, so an unset key degrades that one step and labels it on the page
# rather than stopping the run. The groups marked [live] are the ones the
# running console reads; the rest belong to the setup scripts.

NAMESPACE=demojam-agentic-patching

# --- [live] Insights (Lightspeed service account) ---
# Both or neither: supplies the CVE list and the per-CVE detail.
LIGHTSPEED_CLIENT_ID=
LIGHTSPEED_CLIENT_SECRET=

# --- GitHub (setup scripts) ---
GIT_HUB_TOKEN=

# --- Inference (KServe in-cluster or external MaaS) ---
INFERENCE_MODEL=llama-17b/llama-scout-17b
VLLM_URL=   # e.g. https://maas-rhdp.apps.maas.redhatworkshops.io/v1
VLLM_API_TOKEN=
VLLM_TLS_VERIFY=false

# --- Optional: Milvus / Postgres (defaults shown in openshift/secrets/*.yaml.example) ---
# POSTGRES_PASSWORD=changeme
# MILVUS_ROOT_PASSWORD=changeme

# --- Optional: skip long steps ---
# SKIP_BUILD=false
# SKIP_RAG_INGEST=false
# LLAMA_STACK_URL=

# --- [live] Risk model (XGBoost on OpenShift) ---
# Scores every host in one batched call. Blank and the console uses its
# heuristic scorer, which gates at 55 rather than the model threshold of 30.
RISK_URL=   # e.g. https://risk-score-agentic-patching.apps.cluster-kqn6x.dyn.redhatworkshops.io/v1/models/risk-score:predict
RISK_VERIFY_TLS=false

# --- [live] RAG (rag-setup/) — port-forward: oc port-forward svc/llamastack 8321:8321 -n agentic-patching ---
LLAMA_STACK_URL=http://127.0.0.1:8321
VECTOR_DB_ID=   # vs_... printed by rag-setup/ingest.py --ensure
DEFAULT_LLM_MODEL=vllm-inference/llama-scout-17b
INSIGHTS_VERIFY_TLS=false

# --- [live] Ansible Orchestrator (hosts the patching workflow) ---
# The only keys that make a patch real. Unset, the patching steps fall back
# to a simulation that touches no host and is labelled as such on the patch
# plan and on the ROI page.
AO_URL=   # e.g. https://automation-orchestrator-automation-orchestrator.apps.cluster-hmwvt.dyn.redhatworkshops.io
AO_USERNAME=   # e.g. admin
AO_PASSWORD=

# --- Remote Ansible AAP (same controller across clusters; setup scripts) ---
AAP_BASE_URL=   # e.g. https://aap-aap.apps.cluster-hmwvt.dyn.redhatworkshops.io/api/controller/v2
AAP_TOKEN=
AAP_DEFAULT_PROJECT_ID=   # e.g. 43
AAP_DEFAULT_INVENTORY_ID=1
AAP_DEFAULT_EXECUTION_ENVIRONMENT_ID=2
AAP_DEFAULT_ORGANIZATION_ID=1
AAP_VERIFY_TLS=false
