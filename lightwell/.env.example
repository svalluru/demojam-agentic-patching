# Copy to lightwell/.env (gitignored). Shell format: KEY=value
# Read only by lightwell/server.py. It does not read the console's .env.

# demo = recorded data, no network at all.  live = real GitHub / GitLab and OSV.dev calls.
LIGHTWELL_MODE=demo

# Optional. Without it GitHub allows 60 API calls an hour (about 20 repositories) and
# private repositories cannot be read. A fine-grained token with read-only "Contents"
# and "Metadata" access on the repositories you scan is enough.
GITHUB_TOKEN=

# GitLab. All optional. Without a token only public projects can be read.
# GITLAB_TOKEN is for gitlab.com only and needs read_api or read_repository.
# Self-hosted GitLab: list the host in GITLAB_HOSTS (comma-separated, with :port if not 443) or it is refused, and
# give its token in GITLAB_TOKENS as host=token pairs. A token is only ever sent to its own host.
GITLAB_TOKEN=
# GITLAB_HOSTS=git.example.com
# GITLAB_TOKENS=git.example.com=glpat-xxxx

# Lightwell coverage in live mode. A Red Hat Hybrid Cloud Console service account (client id and secret) in a
# user access group that has the "Repositories viewer" role, on an org with a Lightwell Network membership.
# Without both, live mode shows Lightwell coverage as "not checked". Never commit the real values.
LIGHTWELL_CLIENT_ID=
LIGHTWELL_CLIENT_SECRET=
# LIGHTWELL_API_DEMO=true            ask the API for its demo repositories instead of production ones
# LIGHTWELL_API_BASE=https://console.redhat.com/api/lightwell/v0.1
# LIGHTWELL_TOKEN_URL=https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token

# A pom.xml often leaves a dependency's version to its parent POM or an imported BOM. RESOLVE_POMS says how far to look:
#   all   the parents and BOMs in the same repository, then published ones fetched from Maven Central  (default in live mode)
#   repo  only those in the same repository, nothing is fetched
#   off   read each pom.xml alone                                                                       (default in demo mode)
# RESOLVE_POMS=all
# MAVEN_REPO_URL=https://repo1.maven.org/maven2      a mirror (Nexus, Artifactory) to fetch parent and BOM POMs from instead

# A dependency declared as a range (>=2.0, ^1.2.3, [1.0,2.0), 1.+) has no single version. With RESOLVE_RANGES=on the lowest version
# the range allows is looked up and the result is labelled as such. It is the oldest version the range permits, so it can overstate
# the exposure. Default on in live mode, off in demo mode (the recorded answers belong to the pinned versions).
# RESOLVE_RANGES=on

# Remediation (live mode) runs on the AAP controller. AAP_BASE_URL and AAP_TOKEN are read from the project's root .env (the
# same controller the rest of the demo uses); set them here only to override. The job template is created by
# aap-setup/create-app-patch-objects.py. Demo mode needs none of this.
# AAP_APP_TEMPLATE=App Patch - Clone, Update, Build
# AAP_BUILD_HOST=                         optional: one host of the build inventory, passed as the job's limit
# AAP_CA_BUNDLE=                          optional: a CA bundle to trust, for a controller with a private certificate authority

# LIGHTWELL_HOST=127.0.0.1
# LIGHTWELL_PORT=8790
# OSV_BASE_URL=https://api.osv.dev
