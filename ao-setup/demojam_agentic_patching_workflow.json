{
  "schema_version": "2.0.0",
  "name": "DemoJam Agentic Patching",
  "description": "RHEL CVE Remediation - Intelligent Patching",
  "triggers": [
    {
      "id": "trigger_manual",
      "type": "manual_trigger",
      "name": "CVE Alert",
      "parameters": {
        "input_schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "cve_id": {
              "type": "string"
            },
            "lab_tag": {
              "type": "string"
            },
            "group": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "required": [
            "host",
            "cve_id",
            "group"
          ]
        }
      },
      "position": {
        "x": 88.60850782393337,
        "y": -338.0755375436227
      }
    }
  ],
  "nodes": [
    {
      "id": "approval_prod",
      "type": "approval",
      "name": "Approve Production Patch",
      "parameters": {},
      "position": {
        "x": 1057.3186073920363,
        "y": -382.5296469898478
      }
    },
    {
      "id": "fetch_and_commit_prod",
      "type": "aap_job_template",
      "name": "Fetch from Lightspeed & Commit to Gitea",
      "parameters": {
        "credential_id": "45f2404f-6cf5-405a-b676-1ee7a2f082f5",
        "integration_id": "f6fa02e1-bd54-40ea-b506-33722f98d16c",
        "organization_name": "Default",
        "job_template_name": "CVE - Fetch and Commit",
        "extra_vars": {
          "cve_id": "${trigger.cve_id}",
          "lab_tag": "${trigger.lab_tag}",
          "gitea_repo": "lab-user/lightspeed_playbooks",
          "target_host": "${trigger.host}",
          "mcp_server_host": "bastion",
          "mcp_server_port": "8001"
        },
        "diff_mode": false,
        "use_input_variables": true
      },
      "settings": {},
      "position": {
        "x": 1716.6443145244912,
        "y": -440.1950413502909
      }
    },
    {
      "id": "activity_c02f8b27_40d1_404d_9d43_859216281c93",
      "type": "agentic",
      "name": "Scheduler - Find Date Time",
      "parameters": {
        "prompt": "Schedule job on non US Holidays.",
        "llm_model_id": "7b7feb40-f7fe-4555-ab60-f637c166adda",
        "tool_selection_strategy": "NONE",
        "credential_id": "2c420cd3-5d46-4667-b766-05c55b3bfc04"
      },
      "settings": {},
      "position": {
        "x": 119.25529666252561,
        "y": 64.37634992079353
      }
    },
    {
      "id": "deploy_script_prod",
      "type": "aap_job_template",
      "name": "Sync & Deploy via AAP",
      "parameters": {
        "credential_id": "45f2404f-6cf5-405a-b676-1ee7a2f082f5",
        "integration_id": "f6fa02e1-bd54-40ea-b506-33722f98d16c",
        "organization_name": "Default",
        "job_template_name": "CVE - Sync and Deploy Remediation",
        "extra_vars": {
          "cve_id": "${trigger.cve_id}",
          "target_host": "${trigger.host}",
          "playbook_filename": "${fetch_and_commit_prod.artifacts.playbook_filename}"
        },
        "diff_mode": false,
        "use_input_variables": true
      },
      "settings": {},
      "position": {
        "x": 740.168534427087,
        "y": 12.417995690104135
      }
    },
    {
      "id": "route_switch",
      "type": "switch",
      "name": "Route Decision",
      "parameters": {
        "cases": [
          {
            "port": "case_0",
            "label": "Auto-Patch (Dev)",
            "condition": "${trigger.group} == 'auto_patch'"
          },
          {
            "port": "case_1",
            "label": "Approval Required (Prod)",
            "condition": "${trigger.group} == 'approved_patch'"
          }
        ],
        "default_port": "default"
      },
      "position": {
        "x": 562.2896845125638,
        "y": -428.1400028652097
      }
    },
    {
      "id": "run_cve_remediation_prod",
      "type": "aap_job_template",
      "name": "Run CVE Remediation",
      "parameters": {
        "credential_id": "45f2404f-6cf5-405a-b676-1ee7a2f082f5",
        "integration_id": "f6fa02e1-bd54-40ea-b506-33722f98d16c",
        "organization_name": "Default",
        "job_template_name": "${deploy_script_prod.artifacts.template_name}",
        "diff_mode": false,
        "use_input_variables": true
      },
      "position": {
        "x": 1279.3424722414468,
        "y": 40.801985838913595
      }
    }
  ],
  "edges": [
    {
      "from": "route_switch",
      "to": "approval_prod",
      "from_port": "case_1"
    },
    {
      "from": "approval_prod",
      "to": "fetch_and_commit_prod",
      "from_port": "approved"
    },
    {
      "from": "deploy_script_prod",
      "to": "run_cve_remediation_prod"
    },
    {
      "from": "fetch_and_commit_prod",
      "to": "activity_c02f8b27_40d1_404d_9d43_859216281c93"
    },
    {
      "from": "activity_c02f8b27_40d1_404d_9d43_859216281c93",
      "to": "deploy_script_prod"
    },
    {
      "from": "trigger_manual",
      "to": "route_switch"
    }
  ]
}