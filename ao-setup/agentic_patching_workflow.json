  "triggers": [
    {
      "id": "trigger_manual",
      "name": "CVE Alert",
      "type": "manual_trigger",
      "position": {
        "x": 0,
        "y": 300
      },
      "parameters": {
        "input_schema": {
          "type": "object",
          "required": [
            "host",
            "cve_id"
          ],
          "properties": {
            "host": {
              "type": "string",
              "default": "node1",
              "description": "Target hostname in AAP inventory (e.g. node1, node2, node3)"
            },
            "cve_id": {
              "type": "string",
              "default": "",
              "description": "CVE identifier from Red Hat Lightspeed (e.g. CVE-2026-4631). Leave empty to let Lightspeed pick the most critical CVE."
            },
            "lab_tag": {
              "type": "string",
              "default": "group=xfd48",
              "description": "Insights group tag (e.g. group=xfd48)"
            }
          }
        }
      }
    }
  ],
  "description": "CVE remediation driven by the console. The route comes from ${trigger.group}, which the console sets from its own risk score and the operator approval, rather than from an LLM.",
