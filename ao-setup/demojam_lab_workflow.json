  "triggers": [
    {
      "id": "trigger_manual",
      "name": "CVE Alert",
      "type": "manual_trigger",
      "position": {
        "x": 0,
        "y": 300
      },
      "parameters": {
        "input_schema": {
          "type": "object",
          "required": [
            "host",
            "cve_id"
          ],
          "properties": {
            "host": {
              "type": "string",
              "default": "node1",
              "description": "Target hostname in AAP inventory (e.g. node1, node2, node3)"
            },
            "cve_id": {
              "type": "string",
              "default": "",
              "description": "CVE identifier from Red Hat Lightspeed (e.g. CVE-2026-4631). Leave empty to let Lightspeed pick the most critical CVE."
            },
            "lab_tag": {
              "type": "string",
              "default": "group=xfd48",
              "description": "Insights group tag (e.g. group=xfd48)"
            },
            "cvss_score": {
              "type": "string",
              "default": "",
              "description": "The CVE's CVSS score, for the Mattermost card"
            },
            "cve_severity": {
              "type": "string",
              "default": "",
              "description": "Critical / High / Medium / Low from the CVSS, for the card"
            },
            "risk_score": {
              "type": "string",
              "default": "",
              "description": "The risk model's score for this host, for the card"
            },
            "triage_reasoning": {
              "type": "string",
              "default": "",
              "description": "Why the console routed this host as it did, for the card"
            },
            "force_fail": {
              "type": "string",
              "default": "false",
              "description": "Test only: \"true\" makes the post-patch health check fail, to exercise the rollback route"
            }
          }
        }
      }
    }
  ],
  "description": "Lab intelligent-patching workflow with the AI Triage Agent removed (the console supplies the route), a checkpoint before the remediation, and a verification step and health check after it. A host that fails its health check takes the rollback route (AAP: CVE - Rollback Patch, dnf history rollback to the checkpoint). Lab job templates, credentials and Gitea repo are unchanged.",
  "schema_version": "2.0.0"
}
