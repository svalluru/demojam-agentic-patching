{
  "name": "App Patch v2",
  "description": "Applications v2: check every jar in the change (cosign for Lightwell builds, Maven Central sha1 for upstream) and commit the generated playbook to Gitea, test the change in a pod on OpenShift Pipelines (a failed test notifies Mattermost and stops before any site), hold LIVE sites at an approval gate, then have AAP sync the playbooks project and run that exact playbook (checked by sha256, pinned to the checksums the pod test verified). A site that fails takes the rollback route (AAP: App Patch v2 - Rollback restores the backup and checks /health); every outcome posts a Mattermost card. Triggered by the console once per site; the lab goes straight through.",
  "schema_version": "2.0.0",
  "triggers": [
    {
      "id": "trigger_manual",
      "name": "Lightwell build",
      "type": "manual_trigger",
      "position": {
        "x": 0,
        "y": 300
      },
      "parameters": {
        "input_schema": {
          "type": "object",
          "required": [
            "host",
            "group",
            "playbook_b64",
            "playbook_sha256",
            "playbook_filename",
            "jar_url"
          ],
          "properties": {
            "host": {
              "type": "string",
              "default": "node1",
              "description": "Target host in the AAP inventory"
            },
            "group": {
              "type": "string",
              "default": "qa_auto",
              "description": "qa_auto runs straight through; prod_review waits for approval"
            },
            "app": {
              "type": "string",
              "default": "",
              "description": "The app being patched"
            },
            "run_id": {
              "type": "string",
              "default": "",
              "description": "The console's run id"
            },
            "gitea_repo": {
              "type": "string",
              "default": "lab-user/app_v2_playbooks",
              "description": "owner/name of the playbooks repository"
            },
            "playbook_filename": {
              "type": "string",
              "default": "",
              "description": "Where the playbook goes in the repository (app-v2/...yml)"
            },
            "playbook_b64": {
              "type": "string",
              "default": "",
              "description": "The generated playbook, base64"
            },
            "playbook_sha256": {
              "type": "string",
              "default": "",
              "description": "Its sha256, checked before commit and again before it runs"
            },
            "jar_url": {
              "type": "string",
              "default": "",
              "description": "The Lightwell build in Nexus"
            },
            "provenance_url": {
              "type": "string",
              "default": "",
              "description": "Its provenance bundle in Nexus"
            },
            "jars_json": {
              "type": "string",
              "default": "",
              "description": "Every jar in the change: [{new_jar, url, source, provenance_url | sha1_url}] (JSON)"
            },
            "lib_json": {
              "type": "string",
              "default": "",
              "description": "Every jar the app runs after the change, for the test in a pod (JSON)"
            },
            "probes": {
              "type": "string",
              "default": "",
              "description": "The /health probes (library=class,...)"
            },
            "port": {
              "type": "string",
              "default": "8080",
              "description": "The app port"
            },
            "expect_json": {
              "type": "string",
              "default": "{}",
              "description": "{library: new jar} the test expects /health to report (JSON)"
            },
            "test_mode": {
              "type": "string",
              "default": "swap",
              "description": "swap: the jars into the image; source: rebuild from the Gitea repo"
            },
            "repo": {
              "type": "string",
              "default": "",
              "description": "owner/name of the app's Gitea repository (source mode)"
            },
            "changes_json": {
              "type": "string",
              "default": "[]",
              "description": "[{name, from, to}] applied to pom.xml (source mode)"
            },
            "nexus_url": {
              "type": "string",
              "default": "",
              "description": "The Nexus the source build resolves through"
            },
            "site": {
              "type": "string",
              "default": "",
              "description": "The site name (lab, edge-site-1, core-dc-1), for the notifications"
            },
            "domain": {
              "type": "string",
              "default": "",
              "description": "The telco domain of the app, for the notifications"
            },
            "change_summary": {
              "type": "string",
              "default": "",
              "description": "One line: every library change in this run, for the notifications"
            },
            "cves": {
              "type": "string",
              "default": "",
              "description": "The CVEs this run fixes, comma separated, for the notifications"
            }
          }
        }
      }
    }
  ],
  "nodes": [
    {
      "id": "commit_to_gitea",
      "name": "Verify Build & Commit to Gitea",
      "type": "aap_job_template",
      "position": {
        "x": 240,
        "y": 300
      },
      "settings": {
        "retry_policy": {
          "max_retries": 2,
          "initial_interval": 10,
          "backoff_coefficient": 2.0
        }
      },
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "app": "${trigger.app}",
          "run_id": "${trigger.run_id}",
          "gitea_repo": "${trigger.gitea_repo}",
          "playbook_filename": "${trigger.playbook_filename}",
          "playbook_b64": "${trigger.playbook_b64}",
          "playbook_sha256": "${trigger.playbook_sha256}",
          "jar_url": "${trigger.jar_url}",
          "provenance_url": "${trigger.provenance_url}",
          "jars_json": "${trigger.jars_json}"
        },
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "job_template_name": "App Patch v2 - Commit to Gitea",
        "organization_name": "Default"
      }
    },
    {
      "id": "test_in_pod",
      "name": "Test in a Pod (OpenShift Pipelines)",
      "type": "aap_job_template",
      "position": {
        "x": 520,
        "y": 300
      },
      "settings": {
        "retry_policy": {
          "max_retries": 0,
          "initial_interval": 10,
          "backoff_coefficient": 2.0
        }
      },
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "app": "${trigger.app}",
          "run_id": "${trigger.run_id}",
          "gitea_repo": "${trigger.gitea_repo}",
          "playbook_filename": "${commit_to_gitea.artifacts.playbook_filename}",
          "lib_json": "${trigger.lib_json}",
          "sha256s_json": "${commit_to_gitea.artifacts.jar_sha256s_json}",
          "probes": "${trigger.probes}",
          "port": "${trigger.port}",
          "expect_json": "${trigger.expect_json}",
          "test_mode": "${trigger.test_mode}",
          "repo": "${trigger.repo}",
          "changes_json": "${trigger.changes_json}",
          "nexus_url": "${trigger.nexus_url}"
        },
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "job_template_name": "App Patch v2 - Test in a Pod",
        "organization_name": "Default"
      }
    },
    {
      "id": "route_switch",
      "name": "Route by environment",
      "type": "switch",
      "position": {
        "x": 1080,
        "y": 300
      },
      "parameters": {
        "cases": [
          {
            "port": "case_0",
            "label": "QA (no approval)",
            "condition": "${trigger.group} == 'qa_auto'"
          },
          {
            "port": "case_1",
            "label": "Prod (approval)",
            "condition": "${trigger.group} == 'prod_review'"
          }
        ],
        "default_port": "default"
      }
    },
    {
      "id": "run_app_patch",
      "name": "Sync & Run (QA)",
      "type": "aap_job_template",
      "position": {
        "x": 1360,
        "y": 120
      },
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "playbook_filename": "${commit_to_gitea.artifacts.playbook_filename}",
          "playbook_sha256": "${trigger.playbook_sha256}",
          "target_hosts": "${trigger.host}",
          "verified_sha256s": "${test_in_pod.artifacts.sha256s_json}"
        },
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "job_template_name": "App Patch v2 - Sync and Run",
        "organization_name": "Default"
      }
    },
    {
      "id": "approval_prod",
      "name": "Approve Production Patch",
      "type": "approval",
      "position": {
        "x": 1360,
        "y": 480
      },
      "parameters": {}
    },
    {
      "id": "run_app_patch_prod",
      "name": "Sync & Run (Prod)",
      "type": "aap_job_template",
      "position": {
        "x": 1640,
        "y": 480
      },
      "parameters": {
        "diff_mode": false,
        "extra_vars": {
          "playbook_filename": "${commit_to_gitea.artifacts.playbook_filename}",
          "playbook_sha256": "${trigger.playbook_sha256}",
          "target_hosts": "${trigger.host}",
          "verified_sha256s": "${test_in_pod.artifacts.sha256s_json}"
        },
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "job_template_name": "App Patch v2 - Sync and Run",
        "organization_name": "Default"
      }
    },
    {
      "id": "test_switch",
      "name": "Pod test passed?",
      "type": "switch",
      "position": {
        "x": 800,
        "y": 300
      },
      "parameters": {
        "cases": [
          {
            "port": "case_0",
            "label": "Passed: to the sites",
            "condition": "${test_in_pod.artifacts.test_outcome} == 'passed'"
          },
          {
            "port": "case_1",
            "label": "Failed: no site",
            "condition": "${test_in_pod.artifacts.test_outcome} == 'failed'"
          }
        ],
        "default_port": "default"
      }
    },
    {
      "id": "notify_test_failed",
      "name": "Notify Mattermost - Test Failed",
      "type": "aap_job_template",
      "position": {
        "x": 1080,
        "y": 620
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Notify Mattermost",
        "extra_vars": {
          "app": "${trigger.app}",
          "site": "${trigger.site}",
          "target_host": "${trigger.host}",
          "group": "${trigger.group}",
          "run_id": "${trigger.run_id}",
          "change_summary": "${trigger.change_summary}",
          "cves": "${trigger.cves}",
          "report_type": "test_failed",
          "pipelinerun": "${test_in_pod.artifacts.pipelinerun}",
          "reason": "${test_in_pod.artifacts.test_reason}"
        }
      }
    },
    {
      "id": "outcome_switch",
      "name": "Patched or failed? (QA)",
      "type": "switch",
      "position": {
        "x": 1640,
        "y": 120
      },
      "parameters": {
        "cases": [
          {
            "port": "case_0",
            "label": "Patched",
            "condition": "${run_app_patch.artifacts.outcome} == 'patched'"
          },
          {
            "port": "case_1",
            "label": "Failed: roll back",
            "condition": "${run_app_patch.artifacts.outcome} == 'failed'"
          }
        ],
        "default_port": "default"
      }
    },
    {
      "id": "notify_patched",
      "name": "Notify Mattermost - Patched",
      "type": "aap_job_template",
      "position": {
        "x": 1920,
        "y": 40
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Notify Mattermost",
        "extra_vars": {
          "app": "${trigger.app}",
          "site": "${trigger.site}",
          "target_host": "${trigger.host}",
          "group": "${trigger.group}",
          "run_id": "${trigger.run_id}",
          "change_summary": "${trigger.change_summary}",
          "cves": "${trigger.cves}",
          "report_type": "patched",
          "playbook_filename": "${commit_to_gitea.artifacts.playbook_filename}",
          "job_id": "${run_app_patch.job_id}",
          "job_url": "${run_app_patch.job_url}"
        }
      }
    },
    {
      "id": "rollback",
      "name": "Roll back (QA)",
      "type": "aap_job_template",
      "position": {
        "x": 1920,
        "y": 200
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Rollback",
        "extra_vars": {
          "target_hosts": "${trigger.host}",
          "rollback_json": "${run_app_patch.artifacts.rollback_json}"
        }
      }
    },
    {
      "id": "notify_rolled_back",
      "name": "Notify Mattermost - Rolled back",
      "type": "aap_job_template",
      "position": {
        "x": 2200,
        "y": 200
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Notify Mattermost",
        "extra_vars": {
          "app": "${trigger.app}",
          "site": "${trigger.site}",
          "target_host": "${trigger.host}",
          "group": "${trigger.group}",
          "run_id": "${trigger.run_id}",
          "change_summary": "${trigger.change_summary}",
          "cves": "${trigger.cves}",
          "report_type": "rolled_back",
          "failed_step": "${run_app_patch.artifacts.failed_step}",
          "failed_reason": "${run_app_patch.artifacts.failed_reason}",
          "restored": "${rollback.artifacts.restored}",
          "job_id": "${rollback.job_id}",
          "job_url": "${rollback.job_url}"
        }
      }
    },
    {
      "id": "outcome_switch_prod",
      "name": "Patched or failed? (Prod)",
      "type": "switch",
      "position": {
        "x": 1920,
        "y": 480
      },
      "parameters": {
        "cases": [
          {
            "port": "case_0",
            "label": "Patched",
            "condition": "${run_app_patch_prod.artifacts.outcome} == 'patched'"
          },
          {
            "port": "case_1",
            "label": "Failed: roll back",
            "condition": "${run_app_patch_prod.artifacts.outcome} == 'failed'"
          }
        ],
        "default_port": "default"
      }
    },
    {
      "id": "notify_patched_prod",
      "name": "Notify Mattermost - Patched (Prod)",
      "type": "aap_job_template",
      "position": {
        "x": 2200,
        "y": 400
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Notify Mattermost",
        "extra_vars": {
          "app": "${trigger.app}",
          "site": "${trigger.site}",
          "target_host": "${trigger.host}",
          "group": "${trigger.group}",
          "run_id": "${trigger.run_id}",
          "change_summary": "${trigger.change_summary}",
          "cves": "${trigger.cves}",
          "report_type": "patched",
          "playbook_filename": "${commit_to_gitea.artifacts.playbook_filename}",
          "job_id": "${run_app_patch_prod.job_id}",
          "job_url": "${run_app_patch_prod.job_url}",
          "approved_by": "the agentic patching console (LIVE-site gate)"
        }
      }
    },
    {
      "id": "rollback_prod",
      "name": "Roll back (Prod)",
      "type": "aap_job_template",
      "position": {
        "x": 2200,
        "y": 560
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Rollback",
        "extra_vars": {
          "target_hosts": "${trigger.host}",
          "rollback_json": "${run_app_patch_prod.artifacts.rollback_json}"
        }
      }
    },
    {
      "id": "notify_rolled_back_prod",
      "name": "Notify Mattermost - Rolled back (Prod)",
      "type": "aap_job_template",
      "position": {
        "x": 2480,
        "y": 560
      },
      "parameters": {
        "credential_id": "REPLACED_BY_create-ao-workflow.sh",
        "integration_id": "REPLACED_BY_create-ao-workflow.sh",
        "organization_name": "Default",
        "diff_mode": false,
        "job_template_name": "App Patch v2 - Notify Mattermost",
        "extra_vars": {
          "app": "${trigger.app}",
          "site": "${trigger.site}",
          "target_host": "${trigger.host}",
          "group": "${trigger.group}",
          "run_id": "${trigger.run_id}",
          "change_summary": "${trigger.change_summary}",
          "cves": "${trigger.cves}",
          "report_type": "rolled_back",
          "failed_step": "${run_app_patch_prod.artifacts.failed_step}",
          "failed_reason": "${run_app_patch_prod.artifacts.failed_reason}",
          "restored": "${rollback_prod.artifacts.restored}",
          "job_id": "${rollback_prod.job_id}",
          "job_url": "${rollback_prod.job_url}",
          "approved_by": "the agentic patching console (LIVE-site gate)"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "trigger_manual",
      "to": "commit_to_gitea"
    },
    {
      "from": "commit_to_gitea",
      "to": "test_in_pod"
    },
    {
      "from": "test_in_pod",
      "to": "test_switch"
    },
    {
      "from": "test_switch",
      "to": "route_switch",
      "from_port": "case_0"
    },
    {
      "from": "test_switch",
      "to": "notify_test_failed",
      "from_port": "case_1"
    },
    {
      "from": "route_switch",
      "to": "run_app_patch",
      "from_port": "case_0"
    },
    {
      "from": "route_switch",
      "to": "approval_prod",
      "from_port": "case_1"
    },
    {
      "from": "approval_prod",
      "to": "run_app_patch_prod",
      "from_port": "approved"
    },
    {
      "from": "run_app_patch",
      "to": "outcome_switch"
    },
    {
      "from": "outcome_switch",
      "to": "notify_patched",
      "from_port": "case_0"
    },
    {
      "from": "outcome_switch",
      "to": "rollback",
      "from_port": "case_1"
    },
    {
      "from": "rollback",
      "to": "notify_rolled_back"
    },
    {
      "from": "run_app_patch_prod",
      "to": "outcome_switch_prod"
    },
    {
      "from": "outcome_switch_prod",
      "to": "notify_patched_prod",
      "from_port": "case_0"
    },
    {
      "from": "outcome_switch_prod",
      "to": "rollback_prod",
      "from_port": "case_1"
    },
    {
      "from": "rollback_prod",
      "to": "notify_rolled_back_prod"
    }
  ]
}
