# The console: page, API and dependency scanner, one image, one process.
#
# No pip install and no requirements.txt, because there are no dependencies:
# the whole application is Python standard library, verified by walking its
# imports against sys.stdlib_module_names. A base image with an interpreter
# is the entire build.
FROM registry.access.redhat.com/ubi9/python-311:latest

USER 0
WORKDIR /opt/app-root/src

COPY agentic-patching.py communication.py results.py fallbacks.py pdf.py ./
COPY frontend/ ./frontend/
# The dependency scanner, served under /lightwell/. Named file by file rather
# than COPY lightwell/: the build context is this whole checkout, and a
# lightwell/.env with a GitHub or AAP token in it would otherwise be baked
# into the image. remediation.py loads its two helpers from aap-setup/.
COPY lightwell/server.py lightwell/remediation.py lightwell/store.py ./lightwell/
COPY lightwell/scanner/ ./lightwell/scanner/
COPY lightwell/ui/ ./lightwell/ui/
COPY lightwell/demo/ ./lightwell/demo/
COPY aap-setup/playbooks/files/ ./aap-setup/playbooks/files/

# OpenShift runs the container as an arbitrary uid in group 0, not as the
# user named here, so anything written at runtime has to be group-writable.
# runs/ holds simulated executions and reports/ the generated PDFs; both are
# mount points for the PVC and both would otherwise be read-only to the
# process that needs them.
RUN mkdir -p runs reports \
 && chgrp -R 0 /opt/app-root/src \
 && chmod -R g=u /opt/app-root/src \
 && chmod -R g+w runs reports

USER 1001
EXPOSE 8788

# The page, the API and /lightwell/, one process.
CMD ["./agentic-patching.py", "serve"]
